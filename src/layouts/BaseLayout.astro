---
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/fonts.css';
import '../styles/global.css';
import { getHeroImage, homeHeroSizes } from '../data/heroImages';

interface Props {
  title?: string;
  description?: string;
  namespace?: string;
  canonicalPath?: string | null;
  robots?: string;
  ogType?: 'website' | 'article' | 'profile';
  socialImage?: string;
  socialImageAlt?: string;
  schema?: unknown | unknown[];
}

const {
  title = 'Luan Alves | Desenvolvimento Web Profissional',
  description = 'Sites institucionais, blogs e landing pages para apresentar sua empresa e facilitar contatos. Design, desenvolvimento e SEO técnico com atendimento direto.',
  namespace = 'home',
  canonicalPath = '/',
  robots,
  ogType = 'website',
  socialImage = '/assets/og-cover.webp',
  socialImageAlt = 'Luan Alves - Desenvolvimento Web Profissional',
  schema,
} = Astro.props;

const siteUrl = 'https://luanalves.com.br';
// The measurement ID is public; a build variable may override or disable it.
const googleAnalyticsId = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID ?? 'G-MWZHK1N4TN';
const hasGoogleAnalytics = /^G-[A-Z0-9]+$/.test(googleAnalyticsId ?? '');
const toAbsoluteUrl = (path: string) =>
  path.startsWith('http') ? path : new URL(path, siteUrl).toString();
const canonicalUrl = canonicalPath ? toAbsoluteUrl(canonicalPath) : null;
const socialPageUrl = canonicalUrl ?? siteUrl;
const socialImageUrl = toAbsoluteUrl(socialImage);
const baseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${siteUrl}/#person`,
    name: 'Luan Alves',
    jobTitle: 'Desenvolvedor Web Freelancer',
    description:
      'Desenvolvedor web especializado em sites institucionais, blogs e landing pages para pequenas e médias empresas em todo o Brasil.',
    url: siteUrl,
    image: toAbsoluteUrl('/assets/hero-img.webp'),
    sameAs: ['https://linkedin.com/in/aka-luan', 'https://github.com/aka-luan'],
    knowsAbout: [
      'Desenvolvimento Web',
      'SEO',
      'Landing Pages',
      'Design para Conversão',
    ],
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'Atendimento ao Cliente',
      availableLanguage: 'Portuguese',
      url: 'https://wa.me/5591982890565',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${siteUrl}/#business`,
    name: 'Luan Alves — Desenvolvimento Web',
    description:
      'Criação de sites institucionais, blogs e landing pages para apresentar empresas e facilitar contatos em todo o Brasil. Atendimento direto, com escopo, cronograma e suporte definidos na proposta.',
    url: siteUrl,
    image: toAbsoluteUrl('/assets/og-cover.webp'),
    founder: { '@id': `${siteUrl}/#person` },
    areaServed: {
      '@type': 'Country',
      name: 'Brasil',
    },
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'Atendimento ao Cliente',
      availableLanguage: 'Portuguese',
      telephone: '+55-91-98289-0565',
      url: 'https://wa.me/5591982890565',
    },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Serviços de Desenvolvimento Web',
      itemListElement: [
        {
          '@type': 'Offer',
          name: 'Site Institucional',
          description:
            'Site profissional para empresas com foco em autoridade de marca, SEO e experiência do usuário.',
          url: `${siteUrl}/site-institucional/`,
          seller: { '@id': `${siteUrl}/#business` },
        },
        {
          '@type': 'Offer',
          name: 'Blog Profissional',
          description:
            'Estrutura editorial com SEO técnico e gestão de conteúdo conforme o escopo contratado.',
          url: `${siteUrl}/blog-profissional/`,
          seller: { '@id': `${siteUrl}/#business` },
        },
        {
          '@type': 'Offer',
          name: 'Landing Page',
          description:
            'Página para apresentar uma oferta de campanha e facilitar contatos, com atenção à velocidade.',
          url: `${siteUrl}/landing-page/`,
          seller: { '@id': `${siteUrl}/#business` },
        },
      ],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}/#website`,
    name: 'Luan Alves',
    url: siteUrl,
    description:
      'Site profissional de Luan Alves, desenvolvedor web freelancer especializado em sites, blogs e landing pages.',
    publisher: { '@id': `${siteUrl}/#person` },
    inLanguage: 'pt-BR',
  },
];

const pageSchema = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const homeHeroImage = namespace === 'home'
  ? await getHeroImage('/assets/hero-img.webp', homeHeroSizes)
  : null;
const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [...baseSchema, ...pageSchema],
};
---

<!doctype html>
<html lang='pt-BR' class='dark'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    {homeHeroImage && (
      <link rel='preload' as='image' href={homeHeroImage.src} imagesrcset={homeHeroImage.srcset} imagesizes={homeHeroImage.sizes} media='(min-width: 961px)' type='image/webp' fetchpriority='high' />
    )}
    <link rel='preload' as='font' href='/fonts/Newsreader/newsreader-600-normal.woff2' type='font/woff2' crossorigin />
    <link rel='preload' as='font' href='/fonts/Manrope/manrope-400-normal.woff2' type='font/woff2' crossorigin />
    <title>{title}</title>
    <meta name='description' content={description} />
    {canonicalUrl && <link rel='canonical' href={canonicalUrl} />}
    {robots && <meta name='robots' content={robots} />}

    <meta property='og:type' content={ogType} />
    <meta property='og:url' content={socialPageUrl} />
    <meta property='og:title' content={title} />
    <meta property='og:description' content={description} />
    <meta property='og:image' content={socialImageUrl} />
    <meta property='og:image:alt' content={socialImageAlt} />
    <meta property='og:image:width' content='1200' />
    <meta property='og:image:height' content='630' />
    <meta property='og:locale' content='pt_BR' />
    <meta property='og:site_name' content='Luan Alves' />

    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:site' content='@aka_luan' />
    <meta name='twitter:creator' content='@aka_luan' />
    <meta name='twitter:title' content={title} />
    <meta name='twitter:description' content={description} />
    <meta name='twitter:image' content={socialImageUrl} />
    <meta name='twitter:image:alt' content={socialImageAlt} />
    <meta name='theme-color' content='#131313' />

    <script type='application/ld+json' set:html={JSON.stringify(schemaGraph)} />

    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <script is:inline>
      document.documentElement.classList.add('js');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion-enabled');
      }
    </script>
  </head>
  <body data-page='home' data-barba='wrapper'>
    <div data-barba='container' data-barba-namespace={namespace}>
      <slot />
    </div>
    {hasGoogleAnalytics && (
      <script is:inline define:vars={{ googleAnalyticsId }}>
        // Keep local development and preview traffic out of the production baseline.
        if (['luanalves.com.br', 'www.luanalves.com.br'].includes(location.hostname)) {
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          // Preserve campaign attribution without forwarding arbitrary query strings.
          const campaign = {};
          const params = new URLSearchParams(location.search);
          for (const [query, field] of Object.entries({
            utm_source: 'campaign_source', utm_medium: 'campaign_medium',
            utm_campaign: 'campaign_name', utm_content: 'campaign_content',
            utm_term: 'campaign_term',
          })) {
            const value = params.get(query);
            if (value) campaign[field] = value.slice(0, 100);
          }
          window.gtag('config', googleAnalyticsId, {
            ...campaign,
            send_page_view: false,
            page_location: location.origin + location.pathname,
            allow_google_signals: false,
            allow_ad_personalization_signals: false,
          });
          const googleTag = document.createElement('script');
          googleTag.async = true;
          googleTag.src = 'https://www.googletagmanager.com/gtag/js?id=' + googleAnalyticsId;
          document.head.append(googleTag);
        }
      </script>
    )}
    <Analytics />
    <SpeedInsights />
    <script>
      import '../scripts/page-transitions';
    </script>
  </body>
</html>
