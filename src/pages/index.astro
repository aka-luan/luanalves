---
import HomeCta from '../components/HomeCta.astro';
import ProjectPortfolio from '../components/ProjectPortfolio.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteNav from '../components/SiteNav.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHeroImage, homeHeroSizes } from '../data/heroImages';
import {
  navigation,
  trustItems,
  services,
  featuredPortfolioProjects,
  reasons,
} from '../data/site';

const whatsappHref =
  'https://wa.me/5591982890565?text=Ol%C3%A1%2C%20Luan!%20Estou%20interessado%20em%20criar%20um%20site%20profissional%20para%20meu%20neg%C3%B3cio.%20Podemos%20conversar%3F';
const heroImage = await getHeroImage('/assets/hero-img.webp', homeHeroSizes);
---

<BaseLayout>
  <SiteNav items={navigation} whatsappHref={whatsappHref} />

  <main id='top'>
    <section class='hero section hero-grid' data-motion='hero'>
      <div class='hero-glow' aria-hidden='true'></div>
      <div class='container hero-content'>
        <div class='hero-copy-block'>
          <p
            class='eyebrow hero-eyebrow'>
            Design & desenvolvimento web
          </p>
          <h1 class='hero-title'>
            <span>
              Um site à altura
              <span class='hero-title__muted'>da sua empresa.</span>
            </span>
          </h1>
          <p class='hero-copy'>
            Sua empresa bem apresentada, seus serviços claros e o contato
            a um toque. Sites feitos com cuidado, do primeiro rascunho à publicação.
          </p>

          <div class='hero-actions'>
            <a
              class='button button-solid'
              href={whatsappHref} data-analytics-position='home_hero'
              target='_blank'
              rel='noreferrer'>
              Vamos criar seu site
              <span class='material-symbols-outlined' aria-hidden='true'>arrow_outward</span>
            </a>
            <a
              class='button button-ghost'
              href='/portfolio/'>
              Explorar projetos
            </a>
          </div>

          <div class='hero-proof' aria-label='Diferenciais principais'>
            <article
              class='hero-proof-item'>
              <strong>5+</strong>
              <span>Anos de experiência</span>
            </article>
            <article
              class='hero-proof-item'>
              <strong>Direto</strong>
              <span>Com quem cria seu site</span>
            </article>
            <article
              class='hero-proof-item'>
              <strong>Belém, PA</strong>
              <span>Para empresas de todo o Brasil</span>
            </article>
          </div>
        </div>

        <figure
          class='hero-media'>
          <div class='hero-media-frame'>
            <img
              {...heroImage}
              alt='Retrato de Luan Alves, desenvolvedor web.'
              decoding='async'
              fetchpriority='high'
            />
            <figcaption class='hero-location-chip'>
              <span>
                <strong>Luan Alves</strong>
                <small>Desenvolvedor web · Belém, PA</small>
              </span>
            </figcaption>
          </div>
        </figure>
      </div>
    </section>

    <section class='trust-bar'>
      <div class='container trust-grid'>
        {
          trustItems.map((item, index) => (
            <article
              class:list={['trust-item', index === 1 && 'trust-item-bordered']}>
              <div class='trust-icon'>
                <span class='material-symbols-outlined'>{item.icon}</span>
              </div>
              <p>
                {item.title}
                <br />
                {item.subtitle}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section class='section' id='servicos'>
      <div class='container'>
        <div class='section-heading'>
          <span class='eyebrow'
            >Soluções</span
          >
          <h2>
            Cada objetivo pede<br />um site diferente.
          </h2>
        </div>

        <div class='card-grid'>
          {
            services.map((service) => (
              <a
                href={service.href}
                class='service-card'>
                <div class='service-icon'>
                  <span class='material-symbols-outlined'>{service.icon}</span>
                </div>
                <h3>{service.title}</h3>
                <p>{service.description}</p>
                <div class='card-rule' />
                <ul class='service-list'>
                  {service.bullets.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </a>
            ))
          }
        </div>

        <div
          class='services-more'>
          <p>
            Veja detalhes do processo, formatos de entrega e benefícios da
            criação de sites profissionais.
          </p>
          <a
            class='button button-outline button-compact'
            href='/criacao-de-sites/'>
            Conhecer criação de sites
          </a>
        </div>
      </div>
    </section>

    <ProjectPortfolio projects={featuredPortfolioProjects} />

    <section class='section why-section'>
      <div class='why-grid-accent hero-grid' aria-hidden='true'></div>
      <div class='container why-layout'>
        <div>
          <span class='eyebrow'
            >Diferenciais</span
          >
          <h2>
            Do primeiro contato<br />à última linha de código.
          </h2>
          <p class='why-copy'>
            Você fala com quem planeja, desenha e desenvolve o seu site.
            Objetivos, materiais e decisões são alinhados diretamente comigo,
            do primeiro contato à publicação.
          </p>

          <div class='reason-grid'>
            {
              reasons.map((reason) => (
                <article
                  class='reason-item'>
                  <span class='material-symbols-outlined reason-check'>
                    check_circle
                  </span>
                  <div>
                    <h3>{reason.title}</h3>
                    <p>{reason.subtitle}</p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>

        <div
          class='experience-panel'>
          <div class='experience-card'>
            <span class='experience-number'>5+</span>
            <span class='experience-label'>Anos de experiência</span>
          </div>
          <div class='experience-corner' aria-hidden='true'></div>
        </div>
      </div>
    </section>

    <HomeCta whatsappHref={whatsappHref} />
  </main>

  <SiteFooter links={navigation} />
</BaseLayout>

<style>
  .hero-media-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    min-height: 0;
    overflow: hidden;
    border: 1px solid rgba(241, 238, 231, 0.12);
    background: var(--surface);
    box-shadow: none;
  }
  .hero-media-frame::after {
    background: linear-gradient(180deg, transparent 65%, rgba(16, 20, 17, 0.8));
  }
  .hero-media img {
    position: static;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center top;
    filter: none;
  }
  .hero-location-chip {
    position: absolute;
    inset: auto 1.5rem 1.5rem;
    min-height: 0;
    padding: 0;
    border: 0;
    background: none;
    box-shadow: none;
    backdrop-filter: none;
  }
  .hero-location-chip strong {
    font-family: 'Newsreader', serif;
    font-size: 1.6rem;
    font-weight: 400;
  }
  .hero-location-chip small {
    color: var(--text);
    font-size: 0.75rem;
    margin-top: 0.3rem;
  }
  @media (max-width: 960px) {
    .hero-media { width: min(100%, 32rem); }
    .hero-media-frame { aspect-ratio: 5 / 4; }
    .hero-media img { object-position: center 30%; }
  }
</style>
