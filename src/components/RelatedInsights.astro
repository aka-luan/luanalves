---
import { getCuratedInsights, getInsightPath } from '../data/insights';

interface Props {
  slugs: string[];
  title: string;
  copy: string;
}

const { slugs, title, copy } = Astro.props;
const posts = getCuratedInsights(slugs);
---

<section class='related-insights' aria-labelledby='related-insights-title'>
  <div class='related-insights__inner'>
    <div class='related-insights__copy'>
      <p class='editorial-eyebrow'>Leituras relacionadas</p>
      <h2 id='related-insights-title'>{title}</h2>
      <p>{copy}</p>
    </div>

    <div class='related-insights__grid'>
      {
        posts.map((post) => (
          <a class='related-insights__card' href={getInsightPath(post)}>
            <span class='related-insights__badge'>{post.category}</span>
            <strong>{post.title}</strong>
            <p>{post.excerpt}</p>
            <span class='related-insights__meta'>
              {post.date} · {post.readTime}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .related-insights {
    padding: clamp(4.2rem, 5vw, 5.4rem) 1.15rem 0;
  }

  .related-insights__inner {
    display: grid;
    gap: 2rem;
    width: min(100%, 78rem);
    margin: 0 auto;
  }

  .related-insights__copy {
    display: grid;
    gap: 0.9rem;
    max-width: 40rem;
  }

  .related-insights__copy h2 {
    margin: 0;
    color: #f4f1ee;
    font-family: 'Newsreader', serif;
    font-size: clamp(2.5rem, 4.6vw, 4rem);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1;
    text-wrap: balance;
  }

  .related-insights__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .related-insights__card {
    display: grid;
    gap: 0.8rem;
    min-width: 0;
    padding: 1.3rem;
    border: 1px solid rgba(229, 218, 207, 0.14);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.018), transparent 40%),
      rgba(16, 17, 16, 0.7);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.012),
      0 22px 52px rgba(0, 0, 0, 0.16);
    transition: border-color var(--duration-hover) ease;
  }

  .related-insights__card:hover,
  .related-insights__card:focus-visible {
    border-color: rgba(229, 196, 135, 0.42);
  }

  .related-insights__badge,
  .related-insights__meta {
    color: #dfbd79;
    font-size: 0.62rem;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .related-insights__card strong {
    color: #f4f1ee;
    font-family: 'Newsreader', serif;
    font-size: clamp(1.45rem, 2.3vw, 1.85rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .related-insights__card p {
    margin: 0;
    color: rgba(226, 218, 208, 0.78);
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .related-insights__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
