---
import { navigation as defaultNavigation } from '../data/site';

interface NavItem {
  href: string;
  label: string;
  children?: NavItem[];
}

interface Props {
  items?: NavItem[];
  whatsappHref: string;
  brandHref?: string;
  brandLabel?: string;
  brandAriaLabel?: string;
  motion?: boolean;
}

const {
  items = defaultNavigation,
  whatsappHref,
  brandHref = '#top',
  brandLabel = 'Luan Alves',
  brandAriaLabel = 'Ir para o topo',
  motion = true,
} = Astro.props;

const currentYear = new Date().getFullYear();
const mobileItems = items.flatMap((item) => [item, ...(item.children ?? [])]);
const navMotionAttrs = motion
  ? {
      'data-motion-nav': '',
      'data-motion-hidden': 'nav',
    }
  : {};
---

<nav
  class='site-nav'
  data-header-nav
  data-mobile-nav
  {...navMotionAttrs}>
  <div class='nav-mobile-bar' data-mobile-nav-bar>
    <a
      class='brand'
      href={brandHref}
      aria-label={brandAriaLabel}
      data-header-brand>
      <span class='brand-stack' data-brand-stack aria-hidden='true'>
        <span class='brand-text' data-brand-label>{brandLabel}</span>
      </span>
      <span class='brand-dot' aria-hidden='true'></span>
    </a>

    <button
      class='nav-toggle-button'
      type='button'
      id='site-nav-toggle'
      aria-controls='site-nav-menu'
      aria-expanded='false'
      aria-label='Abrir menu de navegação'>
      <svg
        class='nav-toggle-icon'
        aria-hidden='true'
        viewBox='0 0 32 32'
        fill='none'
        stroke='currentColor'
        stroke-width='2.5'
        stroke-linecap='round'
        stroke-linejoin='round'>
        <path
          class='nav-toggle-icon__curve'
          d='M27 10 13 10C10.8 10 9 8.2 9 6 9 3.5 10.8 2 13 2 15.2 2 17 3.8 17 6L17 26C17 28.2 18.8 30 21 30 23.2 30 25 28.2 25 26 25 23.8 23.2 22 21 22L7 22'
        ></path>
        <path class='nav-toggle-icon__line' d='M7 16 27 16'></path>
      </svg>
    </button>
  </div>

  <div class='nav-menu' id='site-nav-menu' data-mobile-nav-menu>
    <div class='nav-links'>
      {
        items.map((item) =>
          item.children?.length ? (
            <div class='nav-item nav-item--has-children'>
              <a class='nav-link' href={item.href}>
                {item.label}
                <span class='material-symbols-outlined' aria-hidden='true'>
                  expand_more
                </span>
              </a>
              <div class='nav-submenu' aria-label={`${item.label}: páginas`}>
                {item.children.map((child) => (
                  <a href={child.href}>{child.label}</a>
                ))}
              </div>
            </div>
          ) : (
            <a class='nav-link' href={item.href}>{item.label}</a>
          )
        )
      }
    </div>

    <a
      class='button button-outline button-compact'
      href={whatsappHref} data-analytics-position='header'
      target='_blank'
      rel='noreferrer'>
      Falar no WhatsApp
    </a>

    <div class='mobile-menu-content' data-mobile-menu-content>
      <nav class='mobile-menu-nav' aria-label='Menu mobile'>
        {
          mobileItems.map((item, index) => {
            const isChild = items.some((parent) =>
              parent.children?.some((child) => child.href === item.href),
            );

            return (
              <a
                class:list={[
                  'mobile-menu-link',
                  { 'mobile-menu-link--child': isChild },
                ]}
                href={item.href}
                data-mobile-menu-link>
                <span class='mobile-menu-index'>
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class='mobile-menu-copy'>
                  <span>{item.label}</span>
                </span>
              </a>
            );
          })
        }
      </nav>

      <div class='mobile-menu-footer'>
        <a
          class='mobile-menu-cta'
          href={whatsappHref} data-analytics-position='mobile_menu'
          target='_blank'
          rel='noreferrer'>
          <span>Falar no WhatsApp</span>
          <span class='material-symbols-outlined' aria-hidden='true'>arrow_right_alt</span>
        </a>

        <div class='mobile-menu-meta'>
          <div class='mobile-menu-secondary-links'>
            <a href={whatsappHref} data-analytics-position='mobile_menu_secondary' target='_blank' rel='noreferrer'>WhatsApp</a>
            {
              mobileItems.slice(-2).map((item) => (
                <a href={item.href} data-mobile-menu-link>
                  {item.label}
                </a>
              ))
            }
          </div>
          <p>© {currentYear} Luan Alves. Sites para apresentar sua empresa.</p>
        </div>
      </div>
    </div>
  </div>
</nav>

<style>
  .nav-toggle-button {
    display: none;
  }

  .nav-mobile-bar,
  .nav-menu {
    display: flex;
    align-items: center;
    gap: inherit;
  }

  .nav-mobile-bar {
    align-items: center;
    gap: 1rem;
  }

  .mobile-menu-content {
    display: none;
  }

  .nav-item {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .nav-link {
    gap: 0.35rem;
  }

  .nav-link .material-symbols-outlined {
    font-size: 1rem;
    transition: transform 180ms ease;
  }

  .nav-item--has-children:hover .nav-link .material-symbols-outlined,
  .nav-item--has-children:focus-within .nav-link .material-symbols-outlined {
    transform: rotate(180deg);
  }

  .nav-submenu {
    position: absolute;
    top: calc(100% + 0.7rem);
    left: 50%;
    z-index: 25;
    display: grid;
    min-width: 18.5rem;
    padding: 0.65rem;
    border: 1px solid rgba(77, 70, 58, 0.38);
    background: rgba(14, 14, 14, 0.96);
    box-shadow: 0 22px 54px rgba(0, 0, 0, 0.28);
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -0.35rem);
    backdrop-filter: blur(18px);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .nav-submenu::before {
    content: '';
    position: absolute;
    inset: -0.75rem 0 auto;
    height: 0.75rem;
  }

  .nav-item--has-children:hover .nav-submenu,
  .nav-item--has-children:focus-within .nav-submenu {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
  }

  .nav-submenu a {
    justify-content: space-between;
    min-height: 2.85rem;
    padding: 0.35rem 0.7rem;
    border-bottom: 1px solid rgba(77, 70, 58, 0.18);
    letter-spacing: 0.16em;
    white-space: nowrap;
  }

  .nav-submenu a:last-child {
    border-bottom: 0;
  }

  @media (max-width: 767px) {
    .site-nav {
      position: fixed;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 1rem;
      overflow: hidden;
      min-height: 0;
    }

    .nav-mobile-bar {
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      width: 100%;
      flex: 0 0 auto;
    }

    .brand {
      flex: 1 1 auto;
      min-width: 0;
      min-height: 2.75rem;
      align-items: center;
    }

    .nav-toggle-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.9rem;
      height: 2.9rem;
      padding: 0.45rem;
      border: 1px solid rgba(153, 143, 129, 0.24);
      border-radius: 999px;
      background: rgba(14, 14, 14, 0.72);
      color: var(--text);
      cursor: pointer;
      backdrop-filter: blur(16px);
      transition:
        border-color 180ms ease,
        color 180ms ease,
        transform 180ms ease,
        background-color 180ms ease;
    }

    .nav-toggle-button:hover {
      color: var(--primary);
      border-color: rgba(229, 196, 135, 0.4);
    }

    .nav-toggle-button:focus-visible {
      outline: 2px solid var(--primary);
      outline-offset: 4px;
    }

    .nav-toggle-button:active {
      transform: scale(0.96);
    }

    .nav-toggle-icon {
      width: 1.3rem;
      height: 1.3rem;
      overflow: visible;
      transition: transform 0.5s ease-in-out;
    }

    .nav-toggle-icon__curve,
    .nav-toggle-icon__line {
      transition:
        stroke-dasharray 0.5s ease-in-out,
        stroke-dashoffset 0.5s ease-in-out;
    }

    .nav-toggle-icon__curve {
      stroke-dasharray: 12 63;
    }

    .nav-menu {
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      width: 100%;
      min-height: 0;
      overflow: hidden;
    }

    .mobile-menu-content {
      display: none;
      flex: 1 1 auto;
      min-height: 0;
      padding-top: 1.35rem;
      overflow-y: auto;
      overflow-x: hidden;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .mobile-menu-content::-webkit-scrollbar {
      display: none;
    }

    .nav-links,
    .nav-menu > .button {
      display: none;
    }

    .mobile-menu-nav {
      display: flex;
      flex-direction: column;
      gap: 1.6rem;
      margin: auto 0;
      padding: 1.25rem 0 2rem;
    }

    .mobile-menu-link {
      display: grid;
      gap: 0.35rem;
      padding-bottom: 0.85rem;
      border-bottom: 1px solid rgba(77, 70, 58, 0.18);
    }

    .mobile-menu-index {
      color: var(--subtle);
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.3em;
      text-transform: uppercase;
    }

    .mobile-menu-copy {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      font-family: 'Newsreader', serif;
      font-size: clamp(2.8rem, 12vw, 4.4rem);
      font-style: italic;
      line-height: 0.95;
      color: var(--muted);
      transition:
        color 220ms ease,
        transform 220ms ease;
    }

    .mobile-menu-link:hover .mobile-menu-copy,
    .mobile-menu-link:focus-visible .mobile-menu-copy {
      color: var(--primary);
      transform: translateX(0.35rem);
    }

    .mobile-menu-link--child {
      margin-left: clamp(1.9rem, 7vw, 3rem);
      padding-left: 0.75rem;
      border-left: 1px solid rgba(229, 196, 135, 0.18);
    }

    .mobile-menu-link--child .mobile-menu-copy {
      font-size: clamp(1.78rem, 8vw, 2.7rem);
      font-style: normal;
    }

    .mobile-menu-link--child .mobile-menu-index {
      color: rgba(153, 143, 129, 0.58);
    }

    .mobile-menu-footer {
      display: grid;
      gap: 1.5rem;
      padding-top: 1.75rem;
    }

    .mobile-menu-cta {
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      width: 100%;
      padding: 1.15rem 1.25rem;
      border: 1px solid rgba(200, 169, 110, 0.8);
      color: var(--primary);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      transition:
        background-color 220ms ease,
        color 220ms ease,
        border-color 220ms ease;
    }

    .mobile-menu-cta:hover {
      background: var(--primary-strong);
      border-color: var(--primary-strong);
      color: var(--primary-ink);
    }

    .mobile-menu-meta {
      display: grid;
      gap: 1rem;
      padding-top: 1.25rem;
      border-top: 1px solid rgba(77, 70, 58, 0.14);
    }

    .mobile-menu-secondary-links {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem 1.5rem;
    }

    .mobile-menu-secondary-links a,
    .mobile-menu-meta p {
      color: var(--subtle);
      font-size: 0.62rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
    }

    .mobile-menu-meta p {
      margin: 0;
      color: rgba(153, 143, 129, 0.5);
    }

    .site-nav.is-menu-open .nav-toggle-button {
      color: var(--primary);
      border-color: rgba(229, 196, 135, 0.48);
      background: rgba(14, 14, 14, 0.9);
    }

    .site-nav.is-menu-open .nav-toggle-icon {
      transform: rotate(-45deg);
    }

    .site-nav.is-menu-open .nav-toggle-icon__curve {
      stroke-dasharray: 20 300;
      stroke-dashoffset: -32.42px;
    }

    .site-nav.is-menu-active .nav-menu {
      display: flex;
    }

    .site-nav.is-menu-active .mobile-menu-content {
      display: flex;
      flex-direction: column;
    }

    .site-nav.is-menu-active .nav-menu,
    .site-nav.is-menu-active .nav-mobile-bar {
      width: 100%;
    }

    .site-nav.is-menu-active .nav-menu,
    .site-nav.is-menu-active .nav-menu .mobile-menu-content {
      min-height: 0;
    }

    .site-nav.is-menu-active .nav-menu .mobile-menu-content {
      overflow-y: auto;
    }

    .site-nav.is-menu-active {
      background: rgba(14, 14, 14, 0.96);
      border-color: rgba(77, 70, 58, 0.34);
      box-shadow: 0 18px 36px rgba(0, 0, 0, 0.28);
      backdrop-filter: blur(18px);
    }

    :global(body.menu-open) {
      overflow: hidden;
    }
  }

  @media (max-width: 420px) {
    .site-nav.is-menu-active {
      padding-inline: 1rem;
    }

    .mobile-menu-copy {
      font-size: clamp(2.35rem, 13vw, 3.2rem);
    }
  }
</style>
