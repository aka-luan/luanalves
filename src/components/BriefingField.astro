---
interface Props { name: string; label: string; required?: boolean; type?: string; max?: number; help?: string; options?: readonly string[]; }
const {name,label,required=false,type='text',max=160,help,options} = Astro.props;
const id = name.replaceAll('.','-');
---
<div class="bf-field">
  <label for={id}>{label}{!required && <span> (opcional)</span>}</label>
  {help && <p id={`${id}-help`} class="bf-help">{help}</p>}
  {options ? <select id={id} name={name} required={required} aria-describedby={`${id}-help ${id}-error`}><option value="">Selecione</option>{options.map(o=><option value={o}>{o}</option>)}</select>
    : type === 'textarea' ? <textarea id={id} name={name} rows="4" maxlength={max} required={required} aria-describedby={`${id}-help ${id}-error`}></textarea>
    : <input id={id} name={name} type={type} maxlength={max} required={required} aria-describedby={`${id}-help ${id}-error`} inputmode={type === 'tel' ? 'tel' : undefined} />}
  <p class="bf-error" id={`${id}-error`} data-error={name}></p>
</div>
