---
interface Props {
  whatsappHref: string;
  id?: string;
  title?: string;
  copy?: string;
  buttonLabel?: string;
  analyticsPosition?: string;
}

const {
  whatsappHref,
  id = 'contato',
  title = 'Vamos definir o site que sua empresa precisa?',
  copy = 'Me conte o que sua empresa faz, o objetivo do site e quando pretende publicar. Vamos alinhar estrutura, materiais e escopo antes da proposta. O atendimento é direto comigo, de Belém para todo o Brasil.',
  buttonLabel = 'Conversar sobre meu site',
  analyticsPosition = 'home_final',
} = Astro.props;

---

<section class='section' id={id}>
  <div class='container'>
    <div class='cta-panel shared-cta-panel'>
      <div class='cta-accent' aria-hidden='true'></div>
      <h2>{title}</h2>
      <p>{copy}</p>
      <a
        class='button button-solid button-large'
        href={whatsappHref} data-analytics-position={analyticsPosition}
        target='_blank'
        rel='noreferrer'>
        <span class='material-symbols-outlined' aria-hidden='true'>forum</span>
        {buttonLabel}
      </a>
    </div>
  </div>
</section>
