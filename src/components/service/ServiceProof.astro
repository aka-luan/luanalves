---
import { portfolioProjects } from '../../data/site';
import type { ServicePageContent } from '../../data/servicePages';

interface Props {
  proof: ServicePageContent['proof'];
}

const { proof } = Astro.props;
const project = portfolioProjects.find((item) => item.slug === proof.projectSlug);
if (!project) throw new Error(`Missing service proof case: ${proof.projectSlug}`);
const caseHref = `/portfolio/${project.slug}/`;
---

<section class='service-proof section' id='portfolio' aria-labelledby='service-proof-title'>
  <div class='container service-proof__inner'>
    <div class='service-proof__heading'>
      <p class='editorial-eyebrow'>Projeto de referência · {project.client}</p>
      <h2 id='service-proof-title'>{proof.title}</h2>
      <p>{proof.copy}</p>
    </div>
    <a class='service-proof__image' href={caseHref} aria-label={`Conhecer o case ${project.title}`}>
      <img src={project.image} alt={project.alt} width='900' height='650' loading='lazy' decoding='async' />
    </a>
    <div class='service-proof__story'>
      <div>
        <h3>O problema</h3>
        <p>{project.challenge}</p>
      </div>
      <div>
        <h3>A solução entregue</h3>
        <p>{project.solution}</p>
      </div>
      <p class='service-proof__limit'>{proof.limitation}</p>
      <a class='button button-outline' href={caseHref}>
        Conhecer o case
        <span class='material-symbols-outlined' aria-hidden='true'>arrow_forward</span>
      </a>
      <a class='service-proof__more' href='/portfolio/'>Ver outros projetos</a>
    </div>
  </div>
</section>

<style>
  .service-proof { scroll-margin-top: 6rem; padding-inline: clamp(1.5rem, 6.25vw, 5.85rem); }
  .service-proof__inner {
    display: grid;
    width: min(100%, 82rem);
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }
  .service-proof__heading { grid-column: 1 / -1; max-width: 52rem; }
  .service-proof h2 {
    margin: 1rem 0;
    font-family: 'Newsreader', serif;
    font-size: clamp(2.2rem, 4.5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .service-proof p { color: var(--muted); line-height: 1.7; }
  .service-proof__image { align-self: start; border: 1px solid var(--primary); }
  .service-proof__image img { display: block; width: 100%; height: auto; }
  .service-proof__story { display: grid; gap: 1.2rem; align-content: start; min-width: 0; }
  .service-proof h3 { margin: 0 0 0.4rem; font-size: 1rem; }
  .service-proof__story p { margin: 0; }
  .service-proof__limit { padding-top: 1rem; border-top: 1px solid var(--primary); font-size: 0.88rem; }
  .service-proof__story .button { justify-self: start; }
  .service-proof__more { color: var(--primary); text-decoration: underline; text-underline-offset: 0.25em; }
  @media (max-width: 800px) {
    .service-proof__inner { grid-template-columns: 1fr; }
    .service-proof__story .button { width: 100%; }
  }
</style>
