# Optional override of the public GA4 stream ID (default: G-MWZHK1N4TN).
# An empty value disables GA4 for a build. This ID is not a credential.
PUBLIC_GOOGLE_ANALYTICS_ID=G-MWZHK1N4TN

# Server-only Neon connection (provided by the Vercel Neon integration).
# Never prefix with PUBLIC_ or VITE_. Pull into a gitignored .env.local for local use.
DATABASE_URL=
# Exact allowed browser origin. Default is the production domain.
# Local example for `vercel dev`: http://localhost:3000
BRIEFING_ORIGIN=https://luanalves.com.br
# Optional independent HMAC key for rate limiting; DATABASE_URL is used otherwise.
BRIEFING_RATE_SECRET=
